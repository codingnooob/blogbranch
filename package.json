{
  "name": "blog-link-analyzer",
  "version": "1.5.5",
  "description": "Detects blog posts and extracts linked blog content with titles and authors",
  "main": "background/service-worker.js",
  "scripts": {
    "build": "webpack --mode=production && npm run build:zip",
    "build:firefox": "node scripts/build-firefox.js && npm run build:firefox:zip",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --mode=development --watch",
    "test": "jest --config jest.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:zip": "node scripts/create-zip.js",
    "build:firefox:zip": "node scripts/create-firefox-zip.js",
    "build:all": "npm run build && npm run build:firefox",
    "package": "node scripts/package-chrome.js",
    "package:firefox": "node scripts/package-firefox.js",
    "package:all": "npm run package && npm run package:firefox",
    "package:all-formats": "npm run package && npm run package:firefox",
    "package:crx": "node scripts/package-chrome.js"
  },
  "keywords": [
    "blog",
    "extension",
    "chrome",
    "firefox",
    "ai",
    "summarization",
    "content-analysis"
  ],
  "author": "Blog Link Analyzer Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^10.0.6",
    "@types/chrome": "^0.1.31",
    "@types/firefox-webext-browser": "^143.0.0",
    "archiver": "^7.0.1",
    "babel-loader": "^10.0.0",
    "eslint": "^9.39.1",
    "glob": "^10.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "puppeteer": "^24.31.0",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3",
    "web-ext": "^9.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/codingnooob/blogbranch.git"
  },
  "bugs": {
    "url": "https://github.com/codingnooob/blogbranch/issues"
  },
  "homepage": "https://github.com/codingnooob/blogbranch#readme",
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "background/**/*.js",
      "content/**/*.js",
      "popup/**/*.js",
      "utils/**/*.js",
      "!**/*.test.js",
      "!**/*.backup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(puppeteer)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "webextensions": true
    },
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-unused-vars": "warn",
      "no-console": "warn"
    },
    "globals": {
      "chrome": "readonly",
      "browser": "readonly"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  }
}
