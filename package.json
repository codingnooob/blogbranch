{
  "name": "blog-link-analyzer",
  "version": "1.3.2",
  "description": "Detects blog posts and extracts linked blog content with titles and authors",
  "main": "background/service-worker.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:firefox": "node scripts/build-firefox.js",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --mode=development --watch",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "package:chrome": "node scripts/package-chrome.js",
    "package:firefox": "node scripts/build-firefox.js && node scripts/package-firefox.js",
    "package:chrome:crx": "node scripts/package-chrome-crx.js",
    "package:firefox:xpi": "node scripts/build-firefox.js && node scripts/package-firefox-xpi.js",
    "package:self-hosted": "npm run package:chrome:crx && npm run package:firefox:xpi",
    "package:all-formats": "npm run package:chrome && npm run package:firefox && npm run package:self-hosted",
    "package:all": "npm run package:chrome && npm run package:firefox",
    "icons": "node scripts/generate-icons.js",
    "clean": "rimraf dist/ *.zip *.crx *.xpi *.pem temp-* build-firefox",
    "dev": "npm run watch",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "version:bump": "npm version",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "test:extension": "node scripts/test-extension.js",
    "test:integration": "jest tests/extension.test.js",
    "test:all": "npm test && npm run test:extension && npm run test:integration",
    "pre-deploy": "./scripts/pre-deploy.sh",
    "deploy:chrome": "echo 'Upload blog-link-analyzer-$(node -p \"require(\\\"./package.json\\\").version\").zip to Chrome Web Store'",
    "deploy:firefox": "echo 'Upload blog-link-analyzer-firefox-$(node -p \"require(\\\"./package.json\\\").version\").zip to Firefox Add-ons'",
    "deploy:all": "npm run deploy:chrome && npm run deploy:firefox",
    "deploy:validate": "./scripts/validate-deployment.sh",
    "deploy:rollback": "./scripts/rollback.sh",
    "deploy:rollback:chrome": "./scripts/rollback.sh latest chrome",
    "deploy:rollback:firefox": "./scripts/rollback.sh latest firefox"
  },
  "keywords": [
    "blog",
    "extension",
    "chrome",
    "firefox",
    "ai",
    "summarization",
    "content-analysis"
  ],
  "author": "Blog Link Analyzer Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^10.0.6",
    "@types/chrome": "^0.1.31",
    "@types/firefox-webext-browser": "^143.0.0",
    "archiver": "^7.0.1",
    "babel-loader": "^10.0.0",
    "eslint": "^9.39.1",
    "glob": "^10.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "puppeteer": "^24.31.0",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3",
    "web-ext": "^9.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/codingnooob/blogbranch.git"
  },
  "bugs": {
    "url": "https://github.com/codingnooob/blogbranch/issues"
  },
  "homepage": "https://github.com/codingnooob/blogbranch#readme",
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "background/**/*.js",
      "content/**/*.js",
      "popup/**/*.js",
      "utils/**/*.js",
      "!**/*.test.js",
      "!**/*.backup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(puppeteer)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "webextensions": true
    },
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-unused-vars": "warn",
      "no-console": "warn"
    },
    "globals": {
      "chrome": "readonly",
      "browser": "readonly"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  }
}
