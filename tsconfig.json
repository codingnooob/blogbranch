{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["chrome", "firefox-webext-browser"]
  },
  "include": [
    "*.js",
    "background/*.js",
    "content/*.js",
    "scripts/*.js",
    "build-firefox/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "dist/**",
    "*.min.js",
    "*.bundle.js"
  ]
}